# Required by the scheduler API.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hunter_compute
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=hunterscheduler
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/path/to/rds-ca.pem

# Optional helper-script shortcut used by tools/db_ping.py and
# tools/run_test_profile_scheduler.py. Do not use real secrets in this file.
DB_PASSWORD=replace_me

# Optional debug flag for candidate lookup. Accepted true values:
# 1, true, yes, on
CANDIDATE_BUILDER_DEBUG=0

# Optional solver timeout in seconds for API requests.
SCHEDULER_SOLVER_TIMEOUT_SECONDS=20
