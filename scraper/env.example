POSTGRES_USER=<db_username>
POSTGRES_PASSWORD=<db_password>
POSTGRES_HOST=<db_host>
POSTGRES_DB=hunterscheduler
POSTGRES_PORT=5432
# For RDS, download the AWS RDS CA bundle and use its local path here.
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/absolute/path/to/global-bundle.pem

# This is only needed for compile-time checking (i.e., it's optional at runtime)
DATABASE_URL=<full_db_url>
