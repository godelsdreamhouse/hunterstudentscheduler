# Server
PORT=3001
NODE_ENV=development

# Session — use a long random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET=your-session-secret-here

# Microsoft Entra ID / OpenID Connect. Keep the client secret server-side.
MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/users/oauth/microsoft/callback
PUBLIC_APP_ORIGIN=http://localhost:5173

# CORS — origin of your frontend dev server
# In development, any localhost port is allowed automatically.
# In production, set this to your deployed frontend URL.
CORS_ORIGIN=https://watchtower-red.vercel.app

# PostgreSQL used for auth, sessions, and course search
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hunter_web
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=hunterscheduler
POSTGRES_SSLROOTCERT=/path/to/rds-ca.pem
POSTGRES_POOL_MAX=3
